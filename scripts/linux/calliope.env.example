# Calliope environment configuration for systemd services
# Copy this file to /etc/calliope/calliope.env and customize as needed

# Backend configuration
CALLIOPE_HOST=127.0.0.1
CALLIOPE_PORT=8247

# Frontend configuration
CALLIOPE_WEB_HOST=127.0.0.1
CALLIOPE_WEB_PORT=5173

# Frontend API proxy target (where the backend is reachable from the browser)
CALLIOPE_API_TARGET=http://127.0.0.1:8247
